{
  "LLM": {
    "Provider": "ollama",
    "OllamaEndpoint": "http://localhost:11434",
    "OllamaModel": "llama3.2",
    "OpenAiKey": "",
    "OpenAiModel": "gpt-4o-mini"
  },
  "AnythingLLM": {
    "BaseUrl": "http://localhost:3001",
    "ApiKey": "",
    "Workspaces": {
      "DotnetBestPractices": "dotnet-best-practices",
      "DesignPatterns": "design-patterns",
      "ProjectCodebase": "project-codebase",
      "ErrorSolutions": "error-solutions",
      "TestingPatterns": "testing-patterns"
    }
  },
  "Orchestration": {
    "MaxAttemptsPerWorkItem": 10,
    "AttemptTimeoutMinutes": 5,
    "EnableParallelExecution": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5000"
}
